# Default: SQLite (zero infrastructure). `pnpm db:setup:sqlite` writes this automatically.
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me"
PORT=4000
CORS_ORIGIN=http://localhost:3000

# To use PostgreSQL instead, set:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kanban?schema=public"
# and run `pnpm db:setup:postgres`